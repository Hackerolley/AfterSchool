NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/afterschool
SESSION_SECRET=replace-this-with-at-least-32-random-characters
CLIENT_ORIGINS=http://localhost:5173
# Omit to use lax locally and none in production; use none for cross-site clients.
# COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=604800000
TRUST_PROXY=0
# Required only for private document uploads and assignment/submission downloads.
# Create these credentials in your Cloudinary account dashboard; keep the API secret server-side.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Quran Foundation Content API credentials. Keep both values on the server.
# Use matching credentials and environment: production or prelive.
# QURAN_CLIENT_ID=
# QURAN_CLIENT_SECRET=
QURAN_API_ENV=production
# Optional one-time provisioning values; set only when running the corresponding bootstrap script.
# PLATFORM_ADMIN_FIRST_NAME=
# PLATFORM_ADMIN_LAST_NAME=
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
